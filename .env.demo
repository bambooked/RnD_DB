# ========================================
# 研究データ管理システム 環境変数設定
# ========================================

# ===== LLMプロバイダー選択 =====
# 使用するLLMプロバイダーを選択してください
# 選択肢: openrouter, openai, gemini
LLM_PROVIDER=openrouter

# ===== OpenRouter API設定 =====
# LLM_PROVIDER=openrouter の場合に使用
# 取得方法: https://openrouter.ai/ でサインアップしてAPIキーを生成
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# OpenRouter オプション設定
# OPENROUTER_API_BASE=https://openrouter.ai/api/v1
# OPENROUTER_REFERER=https://your-site.com
# OPENROUTER_TITLE=Research Data Management System

# ===== OpenAI API設定 =====
# LLM_PROVIDER=openai の場合に使用
# 取得方法: https://platform.openai.com/api-keys でAPIキーを生成
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4-turbo-preview

# ===== Google Gemini API設定 =====
# LLM_PROVIDER=gemini の場合に使用
# 取得方法: https://makersuite.google.com/app/apikey でAPIキーを生成
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.0-flash-exp

# ===== データベース設定 =====
# DATABASE_PATH=agent/database/research_data.db
# DATA_DIR_PATH=data

# ===== API設定 =====
# API_HOST=0.0.0.0
# API_PORT=8000

# ===== ログ設定 =====
# LOG_LEVEL=INFO

# ===== 高度な機能（デフォルトで無効）=====

# Google Drive連携（別途認証情報が必要）
# ENABLE_GOOGLE_DRIVE=false
# GOOGLE_DRIVE_CREDENTIALS_PATH=./credentials/google_drive_credentials.json
# GOOGLE_DRIVE_FOLDER_IDS=["folder_id_1","folder_id_2"]
# GOOGLE_DRIVE_MAX_FILE_SIZE_MB=100

# ベクトル検索（セマンティック検索）
# ENABLE_VECTOR_SEARCH=false
# VECTOR_DB_PROVIDER=chroma

# 認証機能（本番環境用）
# AUTH_ENABLED=false
# GOOGLE_OAUTH_CLIENT_ID=your_client_id
# GOOGLE_OAUTH_CLIENT_SECRET=your_client_secret
# ALLOWED_DOMAINS=university.ac.jp,example.com
